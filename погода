# ТРЕБОВАНИЕ 3: КЛАСС ОТЧЁТА (методы класса и объекта)
# ══════════════════════════════════════════════════════════════
class ReportManager:
    def __init__(self, filename: str = "report.txt"):
        self._filename = filename

    @property
    def filename(self) -> str:
        return self._filename

    @filename.setter
    def filename(self, value: str) -> None:
        self._filename = value

    @staticmethod
    def format_line(login: str, time_in: datetime, time_out: datetime) -> str:
        """@staticmethod — форматирует одну строку отчёта."""
        ti = time_in.strftime("%d.%m.%Y %H:%M:%S") if time_in else "N/A"
        to = time_out.strftime("%d.%m.%Y %H:%M:%S") if time_out else "N/A"
        return f"| {login:<10} | {ti:<20} | {to:<20} |"

    def save(self, user: User) -> None:
        """Метод объекта — сохраняет отчёт в файл."""
        border = "+" + "-" * 12 + "+" + "-" * 22 + "+" + "-" * 22 + "+"
        header = f"| {'login':<10} | {'time_in':<20} | {'time_out':<20} |"
        line = self.format_line(user.login, user.time_in, user.time_out)
        report = "\n".join([border, header, border, line, border])
        with open(self._filename, "w", encoding="utf-8") as f:
            f.write(report)

    def __eq__(self, other):
        return isinstance(other, ReportManager) and self._filename == other._filename

    def __repr__(self):
        return f"ReportManager(filename='{self._filename}')"

    def __str__(self):
        return f"Менеджер отчётов: {self._filename}"


# ══════════════════════════════════════════════════════════════
# ГЛАВНОЕ ПРИЛОЖЕНИЕ
# ══════════════════════════════════════════════════════════════
def main(page: ft.Page):
    page.title = "🌦️ Прогноз погоды"
    page.window_width = 950
    page.window_height = 720
    page.padding = 20
    page.bgcolor = ft.Colors.WHITE
    page.horizontal_alignment = ft.CrossAxisAlignment.CENTER
    page.scroll = ft.ScrollMode.AUTO

    # ─── ТРЕБОВАНИЕ 10: 10+ ПОЛЬЗОВАТЕЛЬСКИХ ОБЪЕКТОВ ───
    cities = ["Москва", "Санкт-Петербург", "Казань", "Сочи", "Омск",
              "Уфа", "Тверь", "Пермь", "Тула", "Иркутск"]
    conditions = ["Солнечно", "Облачно", "Дождь", "Ясно", "Пасмурно"]

    weather_list: list[DetailedWeather] = []
    for city in cities:
        weather_list.append(DetailedWeather(
            city=city,
            temp=round(random.uniform(-15, 30), 1),
            condition=random.choice(conditions),
            humidity=random.randint(30, 90),
            wind=round(random.uniform(1, 10), 1)
        ))

    # ─── ТРЕБОВАНИЕ 8: МАППИНГ ЧЕРЕЗ СВОЙ КЛАСС ───
    weather_map = CustomMap()
    for w in weather_list:
        weather_map.put(w.city, w)

    # ─── ТРЕБОВАНИЕ 9: UI-КОМПОНЕНТЫ (5+) ───
    title = ft.Text("🌦️ Прогноз погоды", size=30,
                    weight=ft.FontWeight.BOLD,
                    text_align=ft.TextAlign.CENTER)

    login_input = ft.TextField(label="Введите логин", width=350,
                               text_align=ft.TextAlign.LEFT)

    login_btn = ft.ElevatedButton("Войти в систему", width=350,
                                  bgcolor=ft.Colors.BLUE_200)

    welcome_text = ft.Text("", size=16, color=ft.Colors.GREEN,
                           text_align=ft.TextAlign.CENTER)

    city_dropdown = ft.Dropdown(
        label="Выберите город",
        width=350,
        options=[ft.dropdown.Option(c) for c in cities]
    )

    show_btn = ft.ElevatedButton("Показать погоду", width=350,
                                 bgcolor=ft.Colors.GREEN_200)

    result_text = ft.Text("", size=18, weight=ft.FontWeight.BOLD,
                          text_align=ft.TextAlign.CENTER)

    divider1 = ft.Divider()
    divider2 = ft.Divider()
    section_title = ft.Text("Погода в городах:", size=22,
                            weight=ft.FontWeight.BOLD,
                            text_align=ft.TextAlign.CENTER)

    cards_row = ft.Row(wrap=True,
                       alignment=ft.MainAxisAlignment.CENTER,
                       spacing=15, run_spacing=15)

    # ─── СОСТОЯНИЕ ───
    current_user: User | None = None
    report_manager = ReportManager("report.txt")

    # ─── ТРЕБОВАНИЕ 3: ЛОГИКА ЧЕРЕЗ МЕТОДЫ ───
    def on_login(e):
        nonlocal current_user
        if not login_input.value.strip():
            welcome_text.value = "Введите логин!"
            welcome_text.color = ft.Colors.RED
            page.update()
            return
        current_user = User(login_input.value.strip(), datetime.now())
        welcome_text.value = (f"Добро пожаловать, {current_user.login}! "
                              f"Роль: {current_user.get_role()}")
        welcome_text.color = ft.Colors.GREEN
        login_input.disabled = True
        login_btn.disabled = True
        page.update()

    def on_show(e):
        if not city_dropdown.value:
            result_text.value = "Выберите город"
            result_text.color = ft.Colors.RED
            page.update()
            return
        w = weather_map.get(city_dropdown.value)
        result_text.value = f"{w.get_icon()} {w.get_description()}"
        result_text.color = ft.Colors.BLACK
        page.update()

    login_btn.on_click = on_login
    show_btn.on_click = on_show

    # ─── КАРТОЧКИ ПОГОДЫ ───
    cards = [WeatherCard(w) for w in weather_list]
    cards_row.controls = cards

    # ─── ТРЕБОВАНИЕ 11: ВЫРАВНИВАНИЕ КОМПОНЕНТОВ ───
    container = ft.Column(
        controls=[
            title,
            divider1,
            login_input,
            login_btn,
            welcome_text,
            divider2,
            city_dropdown,
            show_btn,
            result_text,
            ft.Divider(),
            section_title,
            cards_row
        ],
        alignment=ft.MainAxisAlignment.CENTER,
        horizontal_alignment=ft.CrossAxisAlignment.CENTER,
        spacing=12
    )
    page.add(container)

    # ─── ТРЕБОВАНИЕ 12: СОХРАНЕНИЕ ОТЧЁТА ПРИ ЗАКРЫТИИ ───
    def on_disconnect(e):
        if current_user is not None:
            current_user.time_out = datetime.now()
            try:
                report_manager.save(current_user)
            except Exception as ex:
                print("Ошибка сохранения отчёта:", ex)

    page.on_disconnect = on_disconnect


if __name__ == "__main__":
    ft.app(target = main)
