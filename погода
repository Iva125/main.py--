import flet as ft
from abc import ABC, abstractmethod
from datetime import datetime
import random


# ══════════════════════════════════════════════════════════════
# ТРЕБОВАНИЕ 8: ЗАПРЕТ dict → КАСТОМНЫЙ КЛАСС-МАППИНГ
# ══════════════════════════════════════════════════════════════
class CustomMap:
    """Замена dict: хранит пары ключ-значение в двух списках."""

    def __init__(self):
        self._keys: list = []
        self._values: list = []

    def put(self, key, value) -> None:
        if key in self._keys:
            self._values[self._keys.index(key)] = value
        else:
            self._keys.append(key)
            self._values.append(value)

    def get(self, key, default=None):
        return self._values[self._keys.index(key)] if key in self._keys else default

    def __len__(self):
        return len(self._keys)

    def __eq__(self, other):
        return isinstance(other, CustomMap) and self._keys == other._keys

    def __repr__(self):
        return f"CustomMap({list(zip(self._keys, self._values))})"

    def __str__(self):
        return " | ".join(f"{k}→{v}" for k, v in zip(self._keys, self._values))


# ══════════════════════════════════════════════════════════════
# ТРЕБОВАНИЕ 4: АБСТРАКТНЫЙ КЛАСС (погода)
# ══════════════════════════════════════════════════════════════
class BaseWeather(ABC):
    """Абстрактный базовый класс для всех погодных сущностей."""

    @abstractmethod
    def get_icon(self) -> str: ...

    @abstractmethod
    def get_description(self) -> str: ...


# ══════════════════════════════════════════════════════════════
# ТРЕБОВАНИЕ 1, 4, 5, 6, 7: КЛАСС ПОГОДЫ
# ══════════════════════════════════════════════════════════════
class Weather(BaseWeather):
    def __init__(self, city: str, temp: float, condition: str):
        self._city = city
        self._temp = temp
        self._condition = condition

    # --- ТРЕБОВАНИЕ 7: ГЕТТЕРЫ И СЕТТЕРЫ ---
    @property
    def city(self) -> str:
        return self._city

    @city.setter
    def city(self, value: str) -> None:
        self._city = value

    @property
    def temp(self) -> float:
        return self._temp

    @temp.setter
    def temp(self, value: float) -> None:
        self._temp = value

    @property
    def condition(self) -> str:
        return self._condition

    @condition.setter
    def condition(self, value: str) -> None:
        self._condition = value

    # --- ТРЕБОВАНИЕ 4: РЕАЛИЗАЦИЯ АБСТРАКТНЫХ МЕТОДОВ ---
    def get_icon(self) -> str:
        mapping = CustomMap()
        mapping.put("Дождь", "🌧️")
        mapping.put("Солнечно", "☀️")
        mapping.put("Облачно", "☁️")
        mapping.put("Ясно", "🌤️")
        mapping.put("Пасмурно", "🌫️")
        return mapping.get(self._condition, "🌡️")

    def get_description(self) -> str:
        return f"{self._city}: {self._temp}°C, {self._condition}"

    # --- ТРЕБОВАНИЕ 5: СПЕЦИАЛЬНЫЕ МЕТОДЫ ---
    def __eq__(self, other):
        return isinstance(other, Weather) and self._city == other._city

    def __lt__(self, other):
        """ТРЕБОВАНИЕ 6: сравнимость — сортировка по температуре."""
        return self._temp < other._temp

    def __hash__(self):
        return hash(self._city)

    def __repr__(self):
        return f"Weather(city='{self._city}', temp={self._temp})"

    def __str__(self):
        return self.get_description()


# ══════════════════════════════════════════════════════════════
# НАСЛЕДНИК: РАСШИРЕННАЯ ПОГОДА
# ══════════════════════════════════════════════════════════════
class DetailedWeather(Weather):
    def __init__(self, city, temp, condition, humidity: int, wind: float):
        super().__init__(city, temp, condition)
        self._humidity = humidity
        self._wind = wind

    @property
    def humidity(self) -> int:
        return self._humidity

    @humidity.setter
    def humidity(self, value: int) -> None:
        self._humidity = value

    @property
    def wind(self) -> float:
        return self._wind

    @wind.setter
    def wind(self, value: float) -> None:
        self._wind = value

    def get_description(self) -> str:
        return (f"{self._city}: {self._temp}°C, {self._condition}, "
                f"💧{self._humidity}%, 🌬️{self._wind} м/с")

    def __eq__(self, other):
        return isinstance(other, DetailedWeather) and self._city == other._city

    def __lt__(self, other):
        return self._temp < other._temp

    def __hash__(self):
        return hash(self._city)

    def __repr__(self):
        return f"DetailedWeather(city='{self._city}', humidity={self._humidity})"

    def __str__(self):
        return self.get_description()


# ══════════════════════════════════════════════════════════════
# АБСТРАКТНЫЙ КЛАСС ПОЛЬЗОВАТЕЛЯ
# ══════════════════════════════════════════════════════════════
class BaseUser(ABC):
    @abstractmethod
    def get_role(self) -> str: ...


# ══════════════════════════════════════════════════════════════
# КЛАСС ПОЛЬЗОВАТЕЛЯ (для отчёта)
# ══════════════════════════════════════════════════════════════
class User(BaseUser):
    def __init__(self, login: str, time_in: datetime):
        self._login = login
        self._time_in = time_in
        self._time_out: datetime | None = None

    @property
    def login(self) -> str:
        return self._login

    @login.setter
    def login(self, value: str) -> None:
        self._login = value

    @property
    def time_in(self) -> datetime:
        return self._time_in

    @time_in.setter
    def time_in(self, value: datetime) -> None:
        self._time_in = value

    @property
    def time_out(self):
        return self._time_out

    @time_out.setter
    def time_out(self, value) -> None:
        self._time_out = value

    def get_role(self) -> str:
        return "Гость"

    def __eq__(self, other):
        return isinstance(other, User) and self._login == other._login

    def __lt__(self, other):
        return self._time_in < other._time_in

    def __hash__(self):
        return hash(self._login)

    def __repr__(self):
        return f"User(login='{self._login}')"

    def __str__(self):
        return f"{self._login} (вход: {self._time_in.strftime('%d.%m.%Y %H:%M:%S')})"


# ══════════════════════════════════════════════════════════════
# ТРЕБОВАНИЕ 2: ПЕРЕОПРЕДЕЛЕНИЕ UI-КОМПОНЕНТА
# (класс наследуется от ft.Column и переопределяет его поведение)
# ══════════════════════════════════════════════════════════════
class WeatherCard(ft.Column):
    """Кастомная карточка погоды — наследник ft.Column."""

    def __init__(self, weather: DetailedWeather):
        super().__init__()
        self._weather = weather

        self._icon = ft.Text(weather.get_icon(), size=36,
                             text_align=ft.TextAlign.CENTER)
        self._city = ft.Text(weather.city, size=18, weight=ft.FontWeight.BOLD,
                             text_align=ft.TextAlign.CENTER)
        self._temp = ft.Text(f"{weather.temp}°C", size=26, color=ft.Colors.BLUE,
                             weight=ft.FontWeight.BOLD,
                             text_align=ft.TextAlign.CENTER)
        self._cond = ft.Text(weather.condition, size=14, italic=True,
                             text_align=ft.TextAlign.CENTER)
        self._details = ft.Text(f"💧 {weather.humidity}%  🌬️ {weather.wind} м/с",
                                size=12, color=ft.Colors.GREY_700,
                                text_align=ft.TextAlign.CENTER)

        self.controls = [self._icon, self._city, self._temp, self._cond, self._details]
        self.alignment = ft.MainAxisAlignment.CENTER
        self.horizontal_alignment = ft.CrossAxisAlignment.CENTER
        self.width = 170
        self.padding = 12
        self.bgcolor = ft.Colors.BLUE_50
        self.border_radius = 12

    @property
    def weather(self) -> DetailedWeather:
        return self._weather

    @weather.setter
    def weather(self, value: DetailedWeather) -> None:
        self._weather = value

    def refresh(self) -> None:
        self._icon.value = self._weather.get_icon()
        self._city.value = self._weather.city
        self._temp.value = f"{self._weather.temp}°C"
        self._cond.value = self._weather.condition
        self._details.value = f"💧 {self._weather.humidity}%  🌬️ {self._weather.wind} м/с"
        self.update()

    def __eq__(self, other):
        return isinstance(other, WeatherCard) and self._weather == other._weather

    def __hash__(self):
        return hash(self._weather.city)


def __repr__(self):
    return f"WeatherCard(city='{self._weather.city}')"

    def __str__(self):
        return f"Карточка: {self._weather.city}"


